{
  "name": "audio-tools",
  "main": "./worker.js",
  "compatibility_date": "2026-09-19",
  "vars": {
    "FIREBASE_PROJECT_ID": "audio-tools-e725e",
    "PAYPAL_ENVIRONMENT": "sandbox"
  },
  "secrets": {
    "required": [
      "PAYPAL_CLIENT_ID",
      "PAYPAL_CLIENT_SECRET",
      "RESEND_API_KEY",
      "SUPPORT_TO_EMAIL",
      "RESEND_FROM_EMAIL"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audio-tools-db",
      "database_id": "cd686bb0-45ca-4449-9760-ac7044961f24"
    }
  ]
}
